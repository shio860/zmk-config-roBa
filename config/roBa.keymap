#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 110

&mt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <200>;
};

&trackball {
//    automouse-layer = <>;
    scroll-layers = <3>;
};

/ {
    combos {
        compatible = "zmk,combos";

        alttab1 {
            timeout-ms = <50>;
            bindings = <&alt_tab>;
            key-positions = <12 13>;
            slow-release;
            layers = <0 1>;
        };

        alttab2 {
            timeout-ms = <50>;
            bindings = <&alt_tab>;
            key-positions = <18 19>;
            slow-release;
            layers = <0 1>;
        };

        ctab1 {
            bindings = <&kp LC(TAB)>;
            key-positions = <11 12>;
            layers = <0 1>;
        };

        ctab2 {
            bindings = <&kp LC(TAB)>;
            key-positions = <19 20>;
            layers = <0 1>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <23 24>;
            layers = <0 1>;
        };

        gv {
            bindings = <&kp LG(V)>;
            key-positions = <24 25>;
            layers = <0 1>;
        };

        kakko {
            bindings = <&ryo_kakko>;
            key-positions = <30 31>;
            layers = <0 1>;
        };

        ten {
            bindings = <&kp FSLH>;
            key-positions = <31 32>;
            layers = <0 1>;
        };


    };

    macros {

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 2 &kp LALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &mo 2>;
            label = "ALT_TAB";
        };

        ryo_kakko: ryo_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(N8) &kp LS(N9) &kp ENTER &kp LEFT>;
            label = "RYO_KAKKO";
        };

        l0_int4: l0_int4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0 &kp INT4>;
            label = "l0_int4";
        };

        l0_int5: l0_int5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0 &kp INT5>;
            label = "l0_int5";
        };

    };

    behaviors {

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        mmt: mouse_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-while-undecided;
            display-name = "Mouse_mt";
        };

        mmkp: mod_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&mkp>;
            hold-while-undecided;
            display-name = "Mod_mkp";
        };

        tdCRN: tap_dance_CRN {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&kp SQT>;
        };

        tdQTT: tap_dance_QTT {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(N2)>, <&kp LS(N7)>;
        };

        tdCOT: tap_dance_COT {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp KP_DOT>, <&kp KP_COMMA>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W       &kp E             &kp R         &kp T                                     &kp Y          &kp U     &kp I      &kp  O        &kp P
&kp A       &mt LALT S  &mmt LS(LCTRL) D  &mmt LSHFT F  &kp G            &mkp MB3     &tog 1      &kp H          &mkp MB1  &lt 3 K    &mmt LCTRL L  &mmt LSHFT J
&mt LGUI Z  &kp X       &kp C             &kp V         &kp B            &kp TAB      &tog 2      &kp N          &kp M     &kp COMMA  &kp  DOT      &mmt LALT MINUS
&l0_int5    &tog 2      &tog 1            &lt 1 BSPC    &mt LCTRL SPACE  &lt 2 ENTER  &lt 2 DEL   &mt LSHFT TAB                                     &l0_int4
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_1 {
            bindings = <
&kp KP_SLASH  &kp N7  &kp N8  &kp N9  &kp LS(SQT)                     &kp LS(N1)    &tdQTT  &kp RBKT       &kp BSLH     &kp LS(MINUS)
&mt LCTRL N0  &kp N4  &kp N5  &kp N6  &kp MINUS     &trans  &kp NUBS  &kp LS(FSLH)  &trans  &lt 3 LS(N8)   &kp LS(N9)   &kp LS(INT1)
&tdCOT        &kp N1  &kp N2  &kp N3  &kp LS(SEMI)  &trans  &kp INT3  &kp LBRC      &tdCRN  &kp LS(COMMA)  &kp LS(DOT)  &kp LS(N6)
&trans        &trans  &trans  &trans  &trans        &trans  &trans    &trans                                            &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_2 {
            bindings = <
&kp LA(F4)       &kp HOME   &kp UP        &kp END         &kp LA(UP)                                 &kp LA(UP)        &kp HOME   &kp UP        &kp END    &kp LA(F4)
&mt LSHFT ENTER  &kp LEFT   &kp DOWN      &kp RIGHT       &kp LS(LG(LEFT))  &trans           &trans  &kp LS(LG(LEFT))  &kp LEFT   &kp DOWN      &kp RIGHT  &mt LSHFT ENTER
&mt LGUI K_APP   &kp PG_UP  &mt LCTRL F2  &kp PG_DN       &td16             &trans           &trans  &td16             &kp PG_UP  &mt LCTRL F2  &kp PG_DN  &mt LGUI K_APP
&trans           &trans     &trans        &mt LSHFT BSPC  &mt LCTRL SPACE   &mt LSHFT ENTER  &trans  &trans                                                &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none                &none  &none            &none  &none            &none 
&none  &none  &none  &none  &none  &none  &none  &none  &mmkp LCTRL MB2  &none  &mmkp LSHFT MB3  &none  
&none  &none  &none  &none  &none  &none  &none  &none  &none            &none  &none            &none  
&none  &none  &none  &none  &none  &none  &none  &none                                           &none  
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };


    };
};
