#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 110

&mt {
    flavor = "balanced";
    quick-tap-ms = <120>;
    tapping-term-ms = <120>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <120>;
    tapping-term-ms = <180>;
};

&trackball {
//    automouse-layer = <>;
    scroll-layers = <2>;
};

/ {
    combos {
        compatible = "zmk,combos";

        alttabl {
            timeout-ms = <200>;
            bindings = <&alt_tab>;
            key-positions = <12 38>;
            slow-release;
            layers = <0 1 2>;
        };

        alttabr {
            timeout-ms = <200>;
            bindings = <&alt_tab>;
            key-positions = <18 41>;
            slow-release;
            layers = <0 1 2>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
            layers = <0 1 2>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <23 24>;
            layers = <0 1 2>;
        };

    };

    macros {

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 2 &kp LALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &mo 2>;
            label = "ALT_TAB";
        };

        l0_int4: l0_int4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0 &kp INT4>;
            label = "l0_int4";
        };

        l0_int5: l0_int5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0 &kp INT5>;
            label = "l0_int5";
        };

    };

    behaviors {

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        mmt: mouse_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&kp>;
            hold-while-undecided;
            display-name = "Mouse_mt";
        };

        mmkp: mod_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&mkp>;
            hold-while-undecided;
            display-name = "Mod_mkp";
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W         &kp E    &kp R             &kp T                                         &kp Y           &kp U     &kp I      &kp  O        &kp P
&lt 3 A     &mmt LSHFT S  &lt 2 D  &mmt LS(LCTRL) F  &mt LS(LALT) G    &mkp MB3        &kp LS(N1)  &kp H           &mkp MB1  &lt 2 K    &mmt LSHFT L  &lt 3 J
&mt LGUI Z  &kp X         &kp C    &kp V             &kp B             &kp TAB         &tog 1      &kp N           &kp M     &kp COMMA  &kp  DOT      &kp MINUS
&l0_int5    &kp LGUI      &tog 1   &lt 1 BSPC        &mmt LCTRL SPACE  &mt LALT ENTER  &lt 1 DEL   &mmt LSHFT TAB                                     &l0_int4
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_1 {
            bindings = <
&kp KP_SLASH     &kp N7  &kp N8    &kp N9  &kp LS(SQT)                     &kp LS(N7)  &kp LS(N2)  &kp RBKT      &kp BSLH    &kp LS(N6)
&lt 3 N0         &kp N4  &lt 2 N5  &kp N6  &kp MINUS     &trans  &kp SEMI  &kp SQT     &trans      &lt 2 LS(N8)  &kp LS(N9)  &lt 3 FSLH
&mt LGUI KP_DOT  &kp N1  &kp N2    &kp N3  &kp LS(SEMI)  &trans  &trans    &kp INT3    &kp LS(N3)  &kp COMMA     &kp DOT     &kp LS(INT1)
&trans           &trans  &trans    &trans  &trans        &trans  &trans    &trans                                            &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_2 {
            bindings = <
&kp LA(F4)  &kp F11        &none   &kp LA(UP)       &kp LS(LC(N1))                                    &kp LS(LC(N1))   &kp LA(UP)         &none &kp F11           &kp LA(F4)
&kp LC(T)   &kp F4         &none   &kp LC(N1)       &kp LC(N1)      &kp LS(LC(TAB))  &trans           &kp LS(LG(LEFT)) &mmkp LCTRL MB2    &none &mkp MB3          &kp LC(T)
&kp LC(W)   &kp LC(MINUS)  &none   &kp LC(PLUS)     &kp LS(LC(N6))  &kp LS(LC(TAB))  &trans           &kp LS(LC(N6))   &kp LS(LA(RIGHT))  &none &kp LS(LA(LEFT))  &kp LC(W)
&trans      &trans         &trans  &kp LS(LC(TAB))  &kp LC(TAB)     &kp ESC          &kp LS(LC(TAB))  &kp LC(TAB)                                                 &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        layer_3 {
            bindings = <
&kp K_APP  &kp HOME   &kp UP    &kp END        &none                                           &none            &kp HOME   &kp UP    &kp END    &kp K_APP  
&none      &kp LEFT   &kp DOWN  &kp RIGHT      &none            &trans           &trans        &none            &kp LEFT   &kp DOWN  &kp RIGHT  &none
&none      &kp PG_UP  &kp F2    &kp PG_DN      &none            &trans           &trans        &none            &kp PG_UP  &kp F2    &kp PG_DN  &none
&trans     &trans     &trans    &mt LGUI BSPC  &mt LCTRL SPACE  &mt LSHFT ENTER  &mt LGUI DEL  &mt LSHFT ENTER                                  &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

    };
};
